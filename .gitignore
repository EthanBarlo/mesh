# Composer
# Root library lockfiles are not committed (package convention); the leading
# slash anchors these to the root so the apps/* applications still commit theirs.
/composer.lock
/vendor

# Node
/node_modules
/package-lock.json
npm-debug.log
yarn-error.log

# Caches
.phpunit.cache
.phpunit.result.cache
/build

# Editors
/.idea
/.fleet
/.vscode

# Misc
phpunit.xml
phpstan.neon
testbench.yaml
/coverage
# Testbench/Pest writes runtime logs here when the suite runs
/storage
