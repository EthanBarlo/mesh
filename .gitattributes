# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Exclude dev-only files from the distributed package archive. The package
# needs src/, config/, stubs/, resources/ (js, views, boost) and composer.json
# at runtime, so none of those are listed here.
/.claude            export-ignore
/.dockerignore      export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.github            export-ignore
/.gitignore         export-ignore
/apps               export-ignore
/docs               export-ignore
/FOLLOW-UPS.md      export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/tests              export-ignore
/tsconfig.json      export-ignore
/vitest.config.ts   export-ignore
